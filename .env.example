# ==============================================================================
# Environment Configuration Template for Todo Application
# Copy this file to `.env` to override defaults
# ==============================================================================

# Project Metadata
PROJECT_NAME="Todo Application"
VERSION="1.0.0"

# Networking Ports
GATEWAY_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Backend & Database Configuration
API_V1_STR=/api/v1
DATABASE_URL=sqlite:////app/data/todo.db

# CORS Configuration (JSON array string)
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:3000", "http://127.0.0.1"]

# Frontend Build Variables
VITE_API_URL=/api/v1
